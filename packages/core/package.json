{
  "name": "@scraperkast/core",
  "version": "0.1.0",
  "description": "Core utilities for ScraperKast — bot detection, pricing, auth, and analytics",
  "keywords": [
    "ai",
    "bot-detection",
    "pricing",
    "authentication",
    "analytics",
    "scraperkast",
    "monetization",
    "content-protection",
    "llm",
    "crawler"
  ],
  "author": {
    "name": "Chirag Ravishankar",
    "url": "https://github.com/chiragravishankar"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragravishankar/scraperkast.git",
    "directory": "packages/core"
  },
  "homepage": "https://scraperkast.com",
  "bugs": {
    "url": "https://github.com/chiragravishankar/scraperkast/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
