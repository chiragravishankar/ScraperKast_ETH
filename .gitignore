.env
.env.local
.env.*.local
.env.production
.env.development

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.njsproj
*.sln
*.user
*.orig

# ── Test artefacts ────────────────────────────────────────────────────────────
coverage/
.nyc_output/

