# ─── ScraperKast Demo — Environment Variables ──────────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#

# JWT secret used to sign/verify bot access tokens.
# Must be at least 32 characters. Rotate immediately if compromised.
JWT_SECRET=dev-secret-change-in-production

# Express server port (default: 3000)
PORT=3000

# ─── Solana Configuration (optional) ─────────────────────────────────────────
#
# Set PLATFORM_WALLET and OWNER_WALLET to enable on-chain USDC payments.
# Leave unset to run in fallback mode (returns paymentUrl instead).
#

# Solana cluster: "devnet" (test, no real money) or "mainnet" (real USDC)
SOLANA_NETWORK=devnet

# Website owner's Solana wallet — receives 95% of each payment
OWNER_WALLET=YOUR_OWNER_WALLET_ADDRESS

# ScraperKast platform wallet — receives 5% of each payment
PLATFORM_WALLET=YOUR_PLATFORM_WALLET_ADDRESS

# Optional: override the default public cluster RPC endpoint
# Useful for private RPC nodes with higher rate limits
# SOLANA_RPC_URL=https://api.devnet.solana.com

# ─── Dodo Payments Configuration (optional) ──────────────────────────────────
#
# Set DODO_API_KEY and DODO_WEBHOOK_SECRET to enable credit-card → USDC checkout.
# Requires Solana (PLATFORM_WALLET + OWNER_WALLET) to be configured.
#

# Your Dodo Payments API key (from https://dashboard.dodopayments.com)
DODO_API_KEY=your_dodo_api_key_here

# Webhook signing secret (from your Dodo dashboard webhook settings)
DODO_WEBHOOK_SECRET=your_webhook_secret_here
