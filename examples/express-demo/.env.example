# ──────────────────────────────────────────────────────────
#  ScraperKast Demo — Environment Variables
#  Copy this file to .env and fill in your own values.
#    cp .env.example .env
# ──────────────────────────────────────────────────────────

# Secret used to sign and verify bot JWT tokens.
# Must match the secret configured on the ScraperKast payment server.
# Generate a strong random value:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-here-change-in-production

# Port the demo server listens on. Default: 3000
PORT=3000
