# ── Bot wallet (testnet ONLY — never use a mainnet key here) ──────────────────
# Private key for the bot's Base Sepolia wallet.
# This wallet needs Base Sepolia USDC to pay for content.
#
# Get testnet USDC: https://faucet.circle.com
# Get Base Sepolia ETH (gas): https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
BOT_PRIVATE_KEY=0x...

# ── Target URL ────────────────────────────────────────────────────────────────
# The protected content endpoint. Defaults to localhost dev server.
TARGET_URL=http://localhost:3001/api/demo-content

# ── RPC (optional) ────────────────────────────────────────────────────────────
# Public Base Sepolia RPC used by default. Override if you have a private node.
BASE_SEPOLIA_RPC=https://sepolia.base.org
