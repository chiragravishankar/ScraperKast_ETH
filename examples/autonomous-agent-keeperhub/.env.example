# ── Agent Wallet (Ethereum) ───────────────────────────────────────────────────
# Generated by: npm run setup
AGENT_PRIVATE_KEY=0x...
AGENT_ADDRESS=0x...

# ── Platform Wallet (receives payments) ───────────────────────────────────────
PLATFORM_WALLET_ADDRESS=0x...

# ── KeeperHub ─────────────────────────────────────────────────────────────────
# Get your API key from https://app.keeperhub.ai
KEEPERHUB_API_KEY=
# Optional: override default API base URL
KEEPERHUB_API_URL=https://api.keeperhub.ai/v1
# Set to "direct" to bypass KeeperHub and transact on-chain directly (testing)
KEEPERHUB_MODE=keeperhub

# ── Ethereum Network (Sepolia testnet) ────────────────────────────────────────
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Sepolia USDC (Circle testnet)
USDC_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ── Target endpoints ──────────────────────────────────────────────────────────
# Dashboard must be running (npm run dev from apps/dashboard)
BASE_URL=http://localhost:3000
TARGET_ENDPOINT=http://localhost:3000/api/test-content-eth
VERIFY_ENDPOINT=http://localhost:3000/api/test-content-eth/verify

# ── Agent configuration ───────────────────────────────────────────────────────
AGENT_GOAL=Find and access content about AI trends
MAX_PRICE_USDC=10000
