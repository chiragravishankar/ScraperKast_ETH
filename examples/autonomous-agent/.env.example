# ── Agent Wallet ──────────────────────────────────────────────────────────────
# Generated by: npm run setup
# Format: JSON array of 64 bytes, e.g. [12,34,56,...]
AGENT_PRIVATE_KEY=
AGENT_WALLET_ADDRESS=

# ── Platform Wallet (receives payments) ───────────────────────────────────────
# Can be any Solana address. The agent will create a USDC token account for it.
PLATFORM_WALLET_ADDRESS=

# ── Token Mint ────────────────────────────────────────────────────────────────
# Set by setup.ts — a custom SPL token mint where the agent is mint authority.
# This lets the demo self-fund without needing an external USDC faucet.
USDC_MINT=

# ── Network ───────────────────────────────────────────────────────────────────
SOLANA_NETWORK=devnet
SOLANA_RPC=https://api.devnet.solana.com

# ── Target endpoints ──────────────────────────────────────────────────────────
# Dashboard must be running (npm run dev from apps/dashboard)
BASE_URL=http://localhost:3000
TARGET_ENDPOINT=http://localhost:3000/api/test-content
VERIFY_ENDPOINT=http://localhost:3000/api/test-content/verify

# ── Agent configuration ───────────────────────────────────────────────────────
AGENT_GOAL=Find and access content about AI trends
MAX_PRICE_USDC=10000
