{
  "name": "scraperkast",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source AI content monetization platform — charge AI bots for content access",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragravishankar/scraperkast.git"
  },
  "homepage": "https://scraperkast.com",
  "bugs": {
    "url": "https://github.com/chiragravishankar/scraperkast/issues"
  },
  "author": {
    "name": "Chirag Ravishankar",
    "url": "https://github.com/chiragravishankar"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
