# ── Solana Network Configuration ─────────────────────────────────────────────
# Use 'devnet' for development and testing.
# Use 'mainnet' for production deployment.
# Defaults to 'devnet' if unset — you must explicitly opt into mainnet.
SOLANA_NETWORK=devnet

# Optional: Custom RPC endpoint for better throughput / rate limits.
# Leave commented to use the public default for the selected network.
# SOLANA_RPC_URL=https://your-rpc-provider.com

# ── ScraperKast ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
